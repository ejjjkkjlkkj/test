# ZERO — executor conformance vectors

CASE VALID_TRANSITION
INPUT_STATE=CREATED
INPUT=OBSERVE
RULE_VERSION=1
EXPECTED_STATUS=SUCCESS
EXPECTED_NEW_STATE=OBSERVED

CASE UNKNOWN_INPUT
INPUT_STATE=CREATED
INPUT=UNKNOWN_OPERATION
RULE_VERSION=1
EXPECTED_STATUS=UNKNOWN
EXPECTED_NEW_STATE=CREATED

CASE_CONTRADICTION
INPUT_STATE=CREATED
INPUT=SET_STATE:DELIVERED
OBSERVATION=NONE
RULE_VERSION=1
EXPECTED_STATUS=CONTRADICTION
EXPECTED_NEW_STATE=CREATED

CASE_DEFERRED_DELIVERY
INPUT_STATE=SENT
INPUT=DELIVERY:DEFERRED
RULE_VERSION=1
EXPECTED_STATUS=DEFERRED
EXPECTED_NEW_STATE=DEFERRED
EXPECTED_DELIVERED=FALSE

CASE_FAILED_DELIVERY
INPUT_STATE=SENT
INPUT=DELIVERY:FAILED
RULE_VERSION=1
EXPECTED_STATUS=FAILED
EXPECTED_NEW_STATE=FAILED
EXPECTED_DELIVERED=FALSE

CASE_DETERMINISM
INPUT_STATE=CREATED
INPUT=OBSERVE
RULE_VERSION=1
RUNS=100
EXPECTED_ALL_RESULTS_IDENTICAL=TRUE

