# ZERO deterministic round-trip vectors

CASE VALID_RECORD
TYPE=EVENT
ID=0001
SOURCE=LOCAL
TARGET=REMOTE
SEQUENCE=1
STATE=CREATED
PAYLOAD=RULE:ARITHMETIC.ADD|INPUT:1,1|EXPECTED:2
PROOF=DEFINED
EXPECTED_VALID=TRUE
EXPECTED_PAYLOAD_UNCHANGED=TRUE

CASE UNKNOWN_PAYLOAD
TYPE=EVENT
ID=0002
SOURCE=LOCAL
TARGET=REMOTE
SEQUENCE=2
STATE=CREATED
PAYLOAD=UNKNOWN
PROOF=DEFINED
EXPECTED_VALID=TRUE
EXPECTED_PAYLOAD_UNCHANGED=TRUE

CASE INCOMPLETE_RECORD
TYPE=EVENT
ID=0003
SOURCE=LOCAL
TARGET=REMOTE
SEQUENCE=3
STATE=CREATED
PROOF=DEFINED
EXPECTED_VALID=FALSE
EXPECTED_REASON=MISSING_PAYLOAD

CASE DELIVERY_DEFERRED
TYPE=EVENT
ID=0004
SOURCE=LOCAL
TARGET=REMOTE
SEQUENCE=4
STATE=DEFERRED
PAYLOAD=RULE:ARITHMETIC.ADD|INPUT:1,1|EXPECTED:2
PROOF=DEFINED
EXPECTED_DELIVERED=FALSE
EXPECTED_PAYLOAD_UNCHANGED=TRUE
