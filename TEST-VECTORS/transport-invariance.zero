# ZERO transport invariance vectors

CASE TRANSPORT_SOFTWARE
MESSAGE=RULE:ARITHMETIC.ADD|INPUT:1,1|EXPECTED:2
TRANSPORT=SOFTWARE
DELIVERY=DELIVERED
EXPECTED_SEMANTICS=RULE:ARITHMETIC.ADD|INPUT:1,1|EXPECTED:2

CASE TRANSPORT_DTN_DEFERRED
MESSAGE=RULE:ARITHMETIC.ADD|INPUT:1,1|EXPECTED:2
TRANSPORT=DTN
DELIVERY=DEFERRED
EXPECTED_SEMANTICS=RULE:ARITHMETIC.ADD|INPUT:1,1|EXPECTED:2

CASE TRANSPORT_RADIO_FAILED
MESSAGE=RULE:ARITHMETIC.ADD|INPUT:1,1|EXPECTED:2
TRANSPORT=RADIO
DELIVERY=FAILED
EXPECTED_SEMANTICS=RULE:ARITHMETIC.ADD|INPUT:1,1|EXPECTED:2

CASE TRANSPORT_SATELLITE_UNPROVEN
MESSAGE=RULE:ARITHMETIC.ADD|INPUT:1,1|EXPECTED:2
TRANSPORT=SATELLITE
DELIVERY=UNKNOWN
PROOF=DEFINED
EXPECTED_SEMANTICS=RULE:ARITHMETIC.ADD|INPUT:1,1|EXPECTED:2
